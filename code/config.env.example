# Copy to config.env and edit if addresses change:
#   cp config.env.example config.env
#
# Scripts and the CLI read these values; they are not hardcoded in C.

PI_USER="cn"

# Use IPv4 if hostnames are not resolvable from the control host.
VPN_A_HOST="10.7.51.1"
VPN_B_HOST="10.7.50.242"

VPN_A_HOSTNAME="vpn-a"
VPN_B_HOSTNAME="vpn-b"

VPN_A_OUTER_IP="10.7.51.1"
VPN_B_OUTER_IP="10.7.50.242"

VPN_PORT="55555"

VPN_A_TUN_IP="192.168.250.1"
VPN_B_TUN_IP="192.168.250.2"
VPN_TUN_PREFIX="30"
VPN_TUN_NAME="tun0"
VPN_TUN_MTU="1400"

REMOTE_PROJECT_DIR="~/code"

BENCH_DURATION="20"
BENCH_OMIT="3"
BENCH_RUNS="5"

# Optional password for sshpass / remote sudo -S.
# Prefer exporting SSHPASS in the shell rather than storing it here.
# PI_SSH_PASSWORD=""
# PI_SUDO_PASSWORD=""

# Optional alternate SSH config (e.g. /dev/null to ignore a broken system include).
# SVPN_SSH_CONFIG=""
