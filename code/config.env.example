# Copy to config.env and edit if addresses change.
#   cp config.env.example config.env
#
# Do not hardcode these values in C source. Scripts and CLI read them here.

PI_USER="cn"

# Hostnames do not currently resolve from the Fedora laptop, so use IPv4.
# If you add /etc/hosts or mDNS later, these may be vpn-a / vpn-b instead.
VPN_A_HOST="10.7.51.1"
VPN_B_HOST="10.7.50.242"

VPN_A_HOSTNAME="vpn-a"
VPN_B_HOSTNAME="vpn-b"

VPN_A_OUTER_IP="10.7.51.1"
VPN_B_OUTER_IP="10.7.50.242"

VPN_PORT="55555"

VPN_A_TUN_IP="192.168.250.1"
VPN_B_TUN_IP="192.168.250.2"
VPN_TUN_PREFIX="30"
VPN_TUN_NAME="tun0"
VPN_TUN_MTU="1400"

REMOTE_PROJECT_DIR="~/code"

BENCH_DURATION="20"
BENCH_OMIT="3"
BENCH_RUNS="5"

# Optional password for sshpass / remote sudo -S.
# Prefer: export SSHPASS in your shell rather than storing it here.
# PI_SSH_PASSWORD=""
# PI_SUDO_PASSWORD=""

# Optional alternate SSH configuration file. This is useful on a workstation
# with an invalid system-wide SSH include; use /dev/null to bypass it.
# SVPN_SSH_CONFIG=""
